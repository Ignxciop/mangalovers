ENVIRONMENT="development"
DATABASE_URL="postgresql://postgres:password@localhost:5432/mangalovers-db"
DATABASE_TEST_URL="postgresql://postgres:1243@localhost:5432/mangalovers-db-tests"
PORT=3000
LOG_LEVEL="info"
# LOG_FILE="/logs/app.log"  # Opcional: archivo adicional en producción (requiere volumen)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL="http://localhost:5173"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="tu-email@dominio.com"
GOOGLE_CLIENT_ID=""
# Zona horaria para los límites de día/semana/mes (Lunes 00:00 para la semana).
# Por defecto: America/Santiago. No depende de la TZ del contenedor.
# APP_TIMEZONE="America/Santiago"
