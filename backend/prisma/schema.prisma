generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BANNED
  SUSPENDED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum SuggestionType {
  BUG
  SUGGESTION
  CONTENT_ERROR
  TECHNICAL_PROBLEM
  OTHER
}

enum SuggestionStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
  CLOSED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  lastname          String
  role              Role               @default(USER)
  status            UserStatus         @default(ACTIVE)
  suspendedUntil    DateTime?
  avatarUrl         String?
  alias             String?   @unique
  aliasChanged      Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  favorites         UserFavorite[]
  chapterReads      UserChapterRead[]
  chapterProgress   UserChapterProgress[]
  pushSubscriptions PushSubscription[]
  suggestions       Suggestion[]
  reviewedSuggestions Suggestion[] @relation("SuggestionReviewedBy")
  activityLogs      UserActivity[]
  sentRequests      Friend[]      @relation("SentFriendRequests")
  receivedRequests  Friend[]      @relation("ReceivedFriendRequests")
  notifications     Notification[]
  seenAnnouncements UserAnnouncement[]

  @@map("users")
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  userId      String
  type        SuggestionType
  title       String
  description String
  image       String?
  status      SuggestionStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reviewedById String?
  reviewedBy   User?            @relation("SuggestionReviewedBy", fields: [reviewedById], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([reviewedById])
  @@map("suggestions")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  isRevoked  Boolean  @default(false)
  replacedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

model Series {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  status       String?
  cover        String?
  chapterCount Int
  summary      String?
  type         String?

  lastChapterPublishedAt DateTime?
  metadataFetchedAt DateTime?

  chapters       Chapter[]
  providerSeries ProviderSeries[]
  genres         SeriesGenre[]
  favorites      UserFavorite[]
  aliases        SeriesAlias[]

  lastChaptersCheck DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([name])
  @@index([lastChapterPublishedAt])
}

model SeriesAlias {
  id       Int    @id @default(autoincrement())
  seriesId Int
  alias    String @unique

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("series_aliases")
}

model Chapter {
  id          Int      @id @default(autoincrement())
  name        String
  number      Float?
  publishedAt DateTime

  seriesId Int
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  pages            Page[]
  providerChapters ProviderChapter[]
  reads         UserChapterRead[]
  progress      UserChapterProgress[]

  pagesScraped Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([seriesId, publishedAt])
  @@index([seriesId, number])
}

model Page {
  id        Int     @id @default(autoincrement())
  url       String
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([url, chapterId])
  @@index([chapterId])
}

model Provider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  series   ProviderSeries[]
  chapters ProviderChapter[]
}

model ProviderSeries {
  id          Int    @id @default(autoincrement())
  providerId  Int
  seriesId    Int

  externalId  String
  slug        String
  url         String?

  summary     String?
  status      String?
  cover       String?

  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  @@unique([providerId, externalId])
  @@unique([providerId, seriesId])
}

model ProviderChapter {
  id Int @id @default(autoincrement())

  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  externalId String

  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([chapterId])
  @@index([providerId])
}

model Genre {
  id    Int     @id @default(autoincrement())
  name  String  @unique

  series SeriesGenre[]
}

model SeriesGenre {
  seriesId Int
  genreId  Int

  series Series @relation(fields: [seriesId], references: [id])
  genre  Genre  @relation(fields: [genreId], references: [id])

  @@id([seriesId, genreId])
}

enum FavoriteStatus {
  Siguiendo
  Terminado
}

model UserFavorite {
  id        Int             @id @default(autoincrement())
  userId    String
  seriesId  Int
  status    FavoriteStatus  @default(Siguiendo)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@map("user_favorites")
}

model UserChapterRead {
  id        Int      @id @default(autoincrement())
  userId    String
  chapterId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("user_chapter_reads")
}

model UserChapterProgress {
  id         Int      @id @default(autoincrement())
  userId     String
  chapterId  Int
  pageNumber Int?
  percentage Int?
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("user_chapter_progress")
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  event     String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event])
  @@index([createdAt])
  @@map("user_activities")
}

model Friend {
  id          Int          @id @default(autoincrement())
  senderId    String
  receiverId  String
  status      FriendStatus @default(PENDING)
  blockedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("friends")
}

model ScraperRun {
  id               Int      @id @default(autoincrement())
  provider         String
  status           String   @default("running")
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  seriesProcessed  Int      @default(0)
  chaptersCreated  Int      @default(0)
  chaptersUpdated  Int      @default(0)
  pagesScraped     Int      @default(0)
  errors           Int      @default(0)
  errorMessage     String?

  @@index([provider, startedAt])
  @@index([startedAt])
  @@map("scraper_runs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // FRIEND_REQUEST | FRIEND_ACCEPTED | SUGGESTION_RESOLVED | NEW_CHAPTER
  title     String
  body      String?
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  active    Boolean  @default(true)
  publishAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seenBy UserAnnouncement[]

  @@index([active, publishAt, expiresAt])
  @@map("announcements")
}

model UserAnnouncement {
  userId         String
  announcementId Int
  seenAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("user_announcements")
}
