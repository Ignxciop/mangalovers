generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SuggestionType {
  BUG
  SUGGESTION
  CONTENT_ERROR
  TECHNICAL_PROBLEM
  OTHER
}

enum SuggestionStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
  CLOSED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  lastname          String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  favorites         UserFavorite[]
  chapterReads      UserChapterRead[]
  pushSubscriptions PushSubscription[]
  suggestions       Suggestion[]
  reviewedSuggestions Suggestion[] @relation("SuggestionReviewedBy")

  @@map("users")
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  userId      String
  type        SuggestionType
  title       String
  description String
  image       String?
  status      SuggestionStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reviewedById String?
  reviewedBy   User?            @relation("SuggestionReviewedBy", fields: [reviewedById], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([reviewedById])
  @@map("suggestions")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  isRevoked  Boolean  @default(false)
  replacedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, isRevoked, expiresAt])
  @@map("refresh_tokens")
}

model Series {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  status       String?
  cover        String?
  chapterCount Int
  summary      String?
  type         String?

  lastChapterPublishedAt DateTime?
  metadataFetchedAt DateTime?

  chapters       Chapter[]
  providerSeries ProviderSeries[]
  genres         SeriesGenre[]
  favorites      UserFavorite[]
  aliases        SeriesAlias[]

  lastChaptersCheck DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([name])
  @@index([lastChapterPublishedAt])
}

model SeriesAlias {
  id       Int    @id @default(autoincrement())
  seriesId Int
  alias    String @unique

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@map("series_aliases")
}

model Chapter {
  id          Int      @id @default(autoincrement())
  name        String
  number      Float?
  publishedAt DateTime

  seriesId Int
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  pages            Page[]
  providerChapters ProviderChapter[]
  reads         UserChapterRead[]

  pagesScraped Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([seriesId, publishedAt])
  @@index([seriesId, number])
}

model Page {
  id        Int     @id @default(autoincrement())
  url       String
  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([url, chapterId])
  @@index([chapterId])
}

model Provider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  series   ProviderSeries[]
  chapters ProviderChapter[]
}

model ProviderSeries {
  id          Int    @id @default(autoincrement())
  providerId  Int
  seriesId    Int

  externalId  String
  slug        String
  url         String?

  summary     String?
  status      String?
  cover       String?

  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  series      Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  @@unique([providerId, externalId])
  @@unique([providerId, seriesId])
}

model ProviderChapter {
  id Int @id @default(autoincrement())

  providerId Int
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  externalId String

  chapterId Int
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([chapterId])
  @@index([providerId])
}

model Genre {
  id    Int     @id @default(autoincrement())
  name  String  @unique

  series SeriesGenre[]
}

model SeriesGenre {
  seriesId Int
  genreId  Int

  series Series @relation(fields: [seriesId], references: [id])
  genre  Genre  @relation(fields: [genreId], references: [id])

  @@id([seriesId, genreId])
}

enum FavoriteStatus {
  Siguiendo
  Terminado
}

model UserFavorite {
  id        Int             @id @default(autoincrement())
  userId    String
  seriesId  Int
  status    FavoriteStatus  @default(Siguiendo)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@map("user_favorites")
}

model UserChapterRead {
  id        Int      @id @default(autoincrement())
  userId    String
  chapterId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("user_chapter_reads")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}